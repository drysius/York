# =============================================================================
# Stardew Valley Dedicated Server (Junimo Server) -- Pterodactyl single-container
# Upstream: https://github.com/stardew-valley-dedicated-server/server
#
# O projeto oficial e um stack docker-compose com 2+ containers:
#   - sdvd/server        -> o jogo (SMAPI + mod JunimoServer + VNC) na baseimage-gui
#   - sdvd/steam-service -> sidecar que baixa os arquivos do jogo da Steam via HTTP
#
# O Pterodactyl roda UM container por servidor, como usuario NAO-root. Esta imagem
# junta os dois servicos em um container so e remove a dependencia de root que a
# baseimage-gui tem no boot (o chown de /data e /config e feito aqui, no build).
# =============================================================================

# Tag das imagens oficiais. Nao existe "latest" publicado ainda (o projeto esta na
# linha 1.5.0-preview); "preview" e o canal corrente. Fixe uma versao (ex.:
# 1.5.0-preview.140) se quiser build reproduzivel.
ARG SDVD_TAG=preview

# Downloader da Steam (vira processo em background dentro do mesmo container)
FROM sdvd/steam-service:${SDVD_TAG} AS steam

# Imagem base = servidor oficial (ja traz SMAPI, o mod, startapp.sh, Xvnc, dotnet)
FROM sdvd/server:${SDVD_TAG}

LABEL maintainer="drysius" \
      org.opencontainers.image.source="https://github.com/stardew-valley-dedicated-server/server" \
      org.opencontainers.image.description="Stardew Valley Dedicated Server adaptado para Pterodactyl"

# UID numerico: a baseimage-gui nao tem o nome "root" no /etc/passwd, entao
# "USER root" nao resolve. "USER 0" dispensa o lookup no passwd.
USER 0
ENV DEBIAN_FRONTEND=noninteractive

# Display virtual headless (Xvfb) + utilitarios de X. A imagem oficial usa Xvnc
# conduzido pela baseimage-gui/cinit (que exige root). No Pterodactyl nos subimos o
# display sozinhos como usuario comum, entao Xvfb e o caminho mais robusto.
# Usamos add-pkg (helper da baseimage-gui): apt-get cru falha nesta base porque
# /var/log e symlink para /config, um volume ausente no build.
RUN add-pkg xvfb x11-utils xauth

# Traz o downloader da Steam para dentro da imagem (substitui o container sidecar)
COPY --from=steam /app /opt/steam-service

# A base sdvd/server nao traz o runtime .NET (o jogo e self-contained). O steam-service
# precisa dele, entao copiamos o runtime da imagem oficial do downloader.
COPY --from=steam /usr/share/dotnet /usr/share/dotnet
RUN ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet

# Usuario do Pterodactyl + posse dos diretorios ja no build.
# A imagem oficial faz "chown -R /data /config" como root no cont-init; como o
# Pterodactyl inicia sem root, fazemos isso aqui, de uma vez.
RUN (groupadd -g 1000 container 2>/dev/null || true) \
 && (useradd -m -d /home/container -u 1000 -g 1000 container 2>/dev/null || true) \
 && mkdir -p /home/container

# Pterodactyl so deixa /home/container (e /tmp) GRAVAVEIS; /data e /config ficam
# read-only em runtime, e o Wings roda o container com um uid proprio (nao o do build).
# Entao: guardamos o conteudo baked (mod JunimoServer, configs, etc.) em /opt/sdvd-default
# e trocamos /data e /config por symlinks para dentro do volume persistente. O entrypoint
# semeia os defaults no boot (o mount do Pterodactyl sobrepoe /home/container).
RUN set -x; \
    mkdir -p /opt/sdvd-default; \
    cp -a /data /opt/sdvd-default/data 2>/dev/null || mkdir -p /opt/sdvd-default/data; \
    cp -a /config /opt/sdvd-default/config 2>/dev/null || mkdir -p /opt/sdvd-default/config; \
    rm -rf /data /config; \
    ln -s /home/container/data /data; \
    ln -s /home/container/config /config; \
    chmod -R a+rX /opt/sdvd-default; \
    chown -R 1000:1000 /home/container

# A imagem base declara VOLUME /data/game e /config/xdg/config/StardewValley. Sob o
# Pterodactyl, o Docker monta volumes anonimos root nesses caminhos, que o uid de
# runtime nao consegue gravar. O startapp.sh tem /data/* hardcoded, entao reescrevemos
# essas referencias para /home/container/* (fora de qualquer path de VOLUME, gravavel).
# Saves/config do jogo sao redirecionados por HOME/XDG_CONFIG_HOME no entrypoint.
RUN sed -i 's#/data/#/home/container/#g' /startapp.sh

COPY ./entrypoint.sh /ptero-entrypoint.sh
RUN chmod +x /ptero-entrypoint.sh

# UID numerico pelo mesmo motivo do USER 0 acima (passwd pode nao ter o nome).
USER 1000
ENV  USER=container \
     HOME=/home/container/home \
     DISPLAY=:0 \
     XDG_CONFIG_HOME=/home/container/xdg/config \
     SMAPI_MODS_PATH=/home/container/Mods

WORKDIR /home/container
STOPSIGNAL SIGINT

CMD ["/bin/bash", "/ptero-entrypoint.sh"]
